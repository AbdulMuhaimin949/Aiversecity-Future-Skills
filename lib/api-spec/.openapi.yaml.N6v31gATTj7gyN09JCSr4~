    LearningResource:
      type: object
      required: [resourceId, title, provider, url, deliveryMode, estimatedHours, cost, currency, level, sourceId, verificationStatus]
      properties:
        resourceId: { type: string }
        title: { type: string }
        provider: { type: string }
        url: { type: string }
        deliveryMode: { type: string }
        estimatedHours: { type: number }
        cost: { type: number }
        currency: { type: string }
        level: { type: string }
        sourceId: { type: string }
        verificationStatus: { type: string }

    PathwayStep:
      type: object
      required: [order, resource, targetSkills, hours, alreadyCovered, sdg, startWeek, endWeek]
      properties:
        order: { type: integer }
        resource:
          $ref: "#/components/schemas/LearningResource"
        targetSkills:
          type: array
          items:
            $ref: "#/components/schemas/SkillRef"
        hours: { type: number }
        alreadyCovered: { type: boolean, description: "True when the user already holds every skill this step targets" }
        sdg:
          $ref: "#/components/schemas/SdgTag"
        startWeek: { type: integer }
        endWeek: { type: integer }

    Pathway:
      type: object
      required: [occupationId, title, sector, currentScore, totalHours, estimatedWeeks, weeklyLearningHours, steps, uncoveredGaps, sdgContribution, disclaimer]
      properties:
        occupationId: { type: string }
        title: { type: string }
        sector: { type: string }
        currentScore: { type: number }
        totalHours: { type: number }
        estimatedWeeks: { type: integer }
        weeklyLearningHours: { type: integer }
        steps:
          type: array
          items:
            $ref: "#/components/schemas/PathwayStep"
        uncoveredGaps:
          type: array
          description: Gap skills with no matching resource in the catalogue (shown honestly instead of inventing a course)
          items:
            $ref: "#/components/schemas/SkillRef"
        sdgContribution:
          type: array
          items:
            $ref: "#/components/schemas/SdgTag"
        disclaimer: { type: string }

    SdgSummary:
      type: object
      required: [goalNumber, goalTitle, occupationCount, skillCount, targets, exampleRoles]
      properties:
        goalNumber: { type: integer }
        goalTitle: { type: string }
        occupationCount: { type: integer }
        skillCount: { type: integer }
        targets:
          type: array
          items: { type: string }
        exampleRoles:
          type: array
          items: { type: string }
