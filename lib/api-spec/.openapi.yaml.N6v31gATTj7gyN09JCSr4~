openapi: 3.1.0
info:
  # Do not change the title, if the title changes, the import paths will be broken
  title: Api
  version: 0.1.0
  description: Aiversecity Future Skills API — serves the Bronze/Silver/Gold pipeline data (taxonomy, trend signals, scenarios, matching, pathways, SDGs).
servers:
  - url: /api
    description: Base API path
tags:
  - name: health
  - name: catalogue
  - name: radar
  - name: matching
  - name: pathway
  - name: assistant
  - name: cv-review
  - name: reviewer
paths:
  /healthz:
    get:
      operationId: healthCheck
      tags: [health]
      summary: Health check
      responses:
        "200":
          description: Healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthStatus"

  /overview:
    get:
      operationId: getOverview
      tags: [catalogue]
      summary: Headline numbers, data freshness and model metrics
      responses:
        "200":
          description: Overview
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Overview"

  /sources:
    get:
      operationId: listSources
      tags: [catalogue]
      summary: Data source catalogue with dates and verification status
      responses:
        "200":
          description: Sources
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/DataSource"

  /skills:
    get:
      operationId: listSkills
      tags: [catalogue]
      summary: Canonical skill taxonomy (for the intake picker)
      responses:
        "200":
          description: Skills
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Skill"

  /sectors:
    get:
      operationId: listSectors
      tags: [catalogue]
      summary: Industry sectors with occupation counts (for interests)
      responses:
        "200":
          description: Sectors
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Sector"

  /sample-profiles:
    get:
      operationId: listSampleProfiles
      tags: [catalogue]
      summary: Synthetic demo personas the user can load instead of typing
      responses:
        "200":
          description: Sample profiles
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/SampleProfile"

  /profile/extract:
    post:
      operationId: extractSkills
      tags: [matching]
      summary: Extract canonical skills from pasted CV text (synonym-normalised extractor)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CvTextInput"
      responses:
        "200":
          description: Extracted skills
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ExtractionResult"

  /profile/scan-cv:
    post:
      operationId: scanCv
      tags: [matching]
      summary: Scan a CV (PDF file or pasted text) for skills, education level, years of experience and related industries
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CvScanInput"
      responses:
        "200":
          description: Scan result for the user to review
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CvScanResult"
        "400":
          description: Invalid input or unreadable PDF
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /radar:
    get:
      operationId: getRadar
      tags: [radar]
      summary: Future Skills Radar — rising and slowing roles and skills under a scenario
      parameters:
        - name: scenario
          in: query
          required: false
          schema:
            $ref: "#/components/schemas/Scenario"
      responses:
        "200":
          description: Radar
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Radar"

  /scenarios/compare:
    get:
      operationId: compareScenarios
      tags: [radar]
      summary: Side-by-side scenario summary (sector-level projected change under each scenario)
      responses:
        "200":
          description: Scenario comparison
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ScenarioComparison"

  /occupations/{occupationId}:
    get:
      operationId: getOccupation
      tags: [catalogue]
      summary: Role detail with skills, SDGs, trend history and scenario forecasts
      parameters:
        - name: occupationId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Occupation detail
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/OccupationDetail"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /matches:
    post:
      operationId: matchRoles
      tags: [matching]
      summary: Rank future roles for a profile with explainable scores and skill gaps
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProfileInput"
      responses:
        "200":
          description: Ranked matches
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MatchResponse"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /pathway:
    post:
      operationId: buildPathway
      tags: [pathway]
      summary: Ordered reskilling plan for a chosen role, with hours, free resources and SDG links
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PathwayInput"
      responses:
        "200":
          description: Pathway
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Pathway"
        "404":
          description: Occupation not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /sdgs:
    get:
      operationId: listSdgSummary
      tags: [catalogue]
      summary: SDG goals covered by roles and skills in the taxonomy
      responses:
        "200":
          description: SDG summary
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/SdgSummary"

  /assistant/status:
    get:
      operationId: getAssistantStatus
      tags: [assistant]
      summary: Whether the career assistant is configured and how much approved knowledge it can search
      responses:
        "200":
          description: Assistant status
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AssistantStatus"

  /assistant/sessions:
    get:
      operationId: listChatSessions
      tags: [assistant]
      summary: The caller's chat sessions, newest first (identified by the guest bearer token)
      responses:
        "200":
          description: Sessions
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ChatSession"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
    post:
      operationId: createChatSession
      tags: [assistant]
      summary: Start a new chat session
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateChatSessionInput"
      responses:
        "201":
          description: Created session
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChatSession"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /assistant/sessions/{sessionId}:
    get:
      operationId: getChatSession
      tags: [assistant]
      summary: A session with all its messages and citations
      parameters:
        - name: sessionId
          in: path
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Session detail
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChatSessionDetail"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
    delete:
      operationId: deleteChatSession
      tags: [assistant]
      summary: Delete a chat session (marked deleted and hidden from the list)
      parameters:
        - name: sessionId
          in: path
          required: true
          schema: { type: string }
      responses:
        "204":
          description: Deleted
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /assistant/sessions/{sessionId}/messages:
    post:
      operationId: sendChatMessage
      tags: [assistant]
      summary: Ask a question; the reply is grounded in approved knowledge and stores the chunks it cites
      parameters:
        - name: sessionId
          in: path
          required: true
          schema: { type: string }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SendChatMessageInput"
      responses:
        "200":
          description: The stored question and answer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ChatExchange"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "429":
          description: Too many messages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "502":
          description: The Gemini API failed; nothing was stored
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "503":
          description: The assistant is not configured (no Gemini key or no embedded knowledge)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /cv-review/status:
    get:
      operationId: getCvReviewStatus
      tags: [cv-review]
      summary: Whether AI claim extraction is available and how many fictional demo CVs exist
      responses:
        "200":
          description: Status
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CvReviewStatus"

  /cv-review/demo-cvs:
    get:
      operationId: listDemoCvs
      tags: [cv-review]
      summary: Fictional demo CVs from the synthetic dataset (paged, searchable)
      parameters:
        - name: search
          in: query
          required: false
          schema: { type: string, maxLength: 100 }
        - name: reviewCasesOnly
          in: query
          required: false
          schema: { type: boolean }
        - name: page
          in: query
          required: false
          schema: { type: integer, minimum: 1 }
      responses:
        "200":
          description: Page of demo CVs
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DemoCvPage"

  /cv-review/demo-cvs/{cvId}:
    get:
      operationId: getDemoCv
      tags: [cv-review]
      summary: A demo CV with its claims, fictional evidence and review results as the applicant sees them
      parameters:
        - name: cvId
          in: path
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Applicant view
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApplicantCvDetail"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /cv-review/demo-cvs/{cvId}/extract:
    post:
      operationId: extractDemoCvClaims
      tags: [cv-review]
      summary: Ask Gemini to extract claims from the CV text (quotes are checked verbatim; AI never decides a claim)
      parameters:
        - name: cvId
          in: path
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Applicant view including the AI-extracted claims
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApplicantCvDetail"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "429":
          description: Too many extractions
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "502":
          description: Gemini failed or returned no verifiable claims; nothing was stored
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "503":
          description: No Gemini API key configured
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /cv-review/claims/{claimId}/appeals:
    post:
      operationId: submitClaimAppeal
      tags: [cv-review]
      summary: Appeal a reviewer's decision on a claim (as the guest applicant)
      parameters:
        - name: claimId
          in: path
          required: true
          schema: { type: string }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AppealInput"
      responses:
        "201":
          description: The stored appeal
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ApplicantAppeal"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          description: Missing or invalid guest token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: The claim has no decision yet, or you already appealed this decision
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "429":
          description: Too many appeals
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /reviewer/me:
    get:
      operationId: getReviewerMe
      tags: [reviewer]
      summary: The signed-in user and whether they hold the reviewer role
      responses:
        "200":
          description: Current user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ReviewerMe"

  /reviewer/queue:
    get:
      operationId: getReviewQueue
      tags: [reviewer]
      summary: Claims waiting for or holding a human decision (reviewers only)
      parameters:
        - name: filter
          in: query
          required: false
          schema: { $ref: "#/components/schemas/ReviewQueueFilter" }
        - name: search
          in: query
          required: false
          schema: { type: string, maxLength: 100 }
        - name: page
          in: query
          required: false
          schema: { type: integer, minimum: 1 }
      responses:
        "200":
          description: Page of claims
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ReviewQueuePage"
        "401":
          description: Not signed in
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "403":
          description: Signed in without the reviewer role
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /reviewer/cvs/{cvId}:
    get:
      operationId: getReviewerCv
      tags: [reviewer]
      summary: A CV with claims, evidence, decision history, appeals and audit trail (reviewers only)
      parameters:
        - name: cvId
          in: path
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Reviewer view
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ReviewerCvDetail"
        "401":
          description: Not signed in
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "403":
          description: Signed in without the reviewer role
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /reviewer/claims/{claimId}/decisions:
    post:
      operationId: decideClaim
      tags: [reviewer]
      summary: Record a reviewer's decision with rationale (writes review_decisions and audit_logs)
      parameters:
        - name: claimId
          in: path
          required: true
          schema: { type: string }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ClaimDecisionInput"
      responses:
        "200":
          description: The updated claim
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ReviewerClaim"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          description: Not signed in
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "403":
          description: Signed in without the reviewer role
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: The claim has an open appeal; resolve the appeal instead
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

  /reviewer/appeals/{appealId}/resolve:
    post:
      operationId: resolveAppeal
      tags: [reviewer]
      summary: Uphold (and change the claim decision) or reject an appeal, with rationale
      parameters:
        - name: appealId
          in: path
          required: true
          schema: { type: string }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AppealResolutionInput"
      responses:
        "200":
          description: The updated claim
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ReviewerClaim"
        "400":
          description: Invalid input
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          description: Not signed in
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "403":
          description: Signed in without the reviewer role
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: The appeal is already resolved
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

components:
  schemas:
    CvReviewStatus:
      type: object
      required: [aiExtractionAvailable, extractionModel, demoCvCount, reviewCaseCount]
      properties:
        aiExtractionAvailable: { type: boolean, description: "True when a Gemini API key is configured" }
        extractionModel: { type: string }
        demoCvCount: { type: integer }
        reviewCaseCount: { type: integer, description: "Claims marked as curated review cases in the dataset" }

    ClaimType:
      type: string
      enum: [education, experience, certification, skill, industry, other]

    ClaimStatus:
      type: string
      enum: [pending_review, evidence_sufficient, more_evidence_requested, escalated, accepted, rejected]

    ReviewerDecision:
      type: string
      enum: [EVIDENCE_SUFFICIENT, REQUEST_MORE_EVIDENCE, ESCALATED]

    AppealStatus:
      type: string
      enum: [submitted, under_review, upheld, rejected, withdrawn]

    ExtractionMethod:
      type: string
      enum: [synthetic_fixture, ai_model, rule_based, manual]

    DemoCvSummary:
      type: object
      required: [id, externalId, candidateName, state, education, yearsExperience, targetOccupation, status, claimCount, pendingCount, decidedCount, reviewCaseCount, aiExtracted]
      properties:
        id: { type: string }
        externalId: { type: string, description: "Dataset id, e.g. SYN_PROFILE_0001" }
        candidateName: { type: string, description: "Fictional name" }
        state: { type: [string, "null"] }
        education: { type: [string, "null"] }
        yearsExperience: { type: [number, "null"] }
        targetOccupation:
          oneOf:
            - $ref: "#/components/schemas/OccupationRef"
            - type: "null"
        status: { type: string, enum: [uploaded, scanned, reviewed, deleted] }
        claimCount: { type: integer }
        pendingCount: { type: integer }
        decidedCount: { type: integer }
        reviewCaseCount: { type: integer }
        aiExtracted: { type: boolean }

    OccupationRef:
      type: object
      required: [id, title]
      properties:
        id: { type: string }
        title: { type: string }

    DemoCvPage:
      type: object
      required: [items, total, page, pageSize]
      properties:
        items:
          type: array
          items: { $ref: "#/components/schemas/DemoCvSummary" }
        total: { type: integer }
        page: { type: integer }
        pageSize: { type: integer }

    ClaimEvidence:
      type: object
      required: [id, kind, quote, documentTitle, issuerName, description, isSynthetic, verifiedExternal]
      properties:
        id: { type: string }
        kind:
          type: string
          enum: [cv_quote, simulated_document_metadata]
          description: "cv_quote = verbatim CV text; simulated_document_metadata = fictional placeholder, not a real document"
        quote: { type: [string, "null"] }
        documentTitle: { type: [string, "null"] }
        issuerName: { type: [string, "null"] }
        description: { type: [string, "null"] }
        isSynthetic: { type: boolean }
        verifiedExternal: { type: boolean, description: "Always false for fictional evidence" }

    DecisionSummary:
      type: object
      required: [decision, rationale, decidedAt, viaAppeal]
      properties:
        decision: { $ref: "#/components/schemas/ReviewerDecision" }
        rationale: { type: string }
        decidedAt: { type: string, format: date-time }
        viaAppeal: { type: boolean, description: "True when the decision was changed by upholding an appeal" }

    ApplicantAppeal:
      type: object
      required: [id, claimId, reason, language, status, resolution, submittedAt, resolvedAt]
      properties:
        id: { type: string }
        claimId: { type: string }
        reason: { type: string }
        language: { $ref: "#/components/schemas/ChatLanguage" }
        status: { $ref: "#/components/schemas/AppealStatus" }
        resolution: { type: [string, "null"] }
        submittedAt: { type: string, format: date-time }
        resolvedAt: { type: [string, "null"], format: date-time }

    ClaimSkill:
      type: object
      required: [id, name]
      properties:
        id: { type: string }
        name: { type: string }

    ApplicantClaim:
      type: object
      required: [id, externalId, claimType, claimText, skill, extractionMethod, extractionModel, status, reviewCase, evidence, latestDecision, myAppeal, canAppeal]
      properties:
        id: { type: string }
        externalId: { type: [string, "null"] }
        claimType: { $ref: "#/components/schemas/ClaimType" }
        claimText: { type: string }
        skill:
          oneOf:
            - $ref: "#/components/schemas/ClaimSkill"
            - type: "null"
        extractionMethod: { $ref: "#/components/schemas/ExtractionMethod" }
        extractionModel: { type: [string, "null"] }
        status: { $ref: "#/components/schemas/ClaimStatus" }
        reviewCase: { type: boolean, description: "Curated review case in the dataset (expected outcome is never exposed)" }
        evidence:
          type: array
          items: { $ref: "#/components/schemas/ClaimEvidence" }
        latestDecision:
          oneOf:
            - $ref: "#/components/schemas/DecisionSummary"
            - type: "null"
        myAppeal:
          oneOf:
            - $ref: "#/components/schemas/ApplicantAppeal"
            - type: "null"
        canAppeal: { type: boolean }

    DemoCvDetail:
      allOf:
        - $ref: "#/components/schemas/DemoCvSummary"
        - type: object
          required: [cvText, provenance]
          properties:
            cvText: { type: string }
            provenance: { type: [string, "null"] }

    ApplicantCvDetail:
      type: object
      required: [cv, claims]
      properties:
